{
	"name": "mmorpg-item-db",
	"main": "src/index.ts",
	"compatibility_date": "2025-02-14",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "item-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"GAME_NAME": "VAMPIR"
	}
}
