{
  "name": "mmorpg-boss-notifier",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boss-notifier-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "DEFAULT_TIMEZONE": "Asia/Tokyo"
  }
}
