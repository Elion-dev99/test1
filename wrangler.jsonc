{
	"name": "mmorpg-boss-notifier",
	"main": "src/index.ts",
	"compatibility_date": "2025-02-14",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "boss-notifier-db",
			"database_id": "873ee573-1dc3-4f09-984c-f8facb0ef217",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"vars": {
		"DEFAULT_TIMEZONE": "Asia/Tokyo"
	}
}